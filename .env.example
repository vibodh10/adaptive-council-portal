# Public application origin. Keep this exact in production.
BETTER_AUTH_URL=http://localhost:3000

# Server-only secrets and database connection.
AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/necivia

# Demo tenant and idempotent seed credentials. Never commit real passwords.
DEMO_MODE=true
DEMO_RESIDENT_EMAIL=resident@example.test
DEMO_RESIDENT_PASSWORD=replace-at-deploy-time
DEMO_STAFF_EMAIL=staff@example.test
DEMO_STAFF_PASSWORD=replace-at-deploy-time

# Private Railway bucket. Use Railway variable references in production.
S3_BUCKET=bucket-name
S3_ACCESS_KEY_ID=access-key-id
S3_SECRET_ACCESS_KEY=secret-access-key
S3_REGION=region
S3_ENDPOINT=https://private-s3-endpoint.example

# Council delivery. Sandbox is the safe default.
COUNCIL_DELIVERY_MODE=sandbox
COUNCIL_WEBHOOK_URL=
COUNCIL_WEBHOOK_SECRET=
